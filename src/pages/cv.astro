---
export const prerender = false;

import { resolveTheme } from '../lib/theme';
import Terminal from '../layouts/Terminal.astro';
import Refined from '../layouts/Refined.astro';
import GeekCv from '../components/geek/Cv.astro';
import RefinedCv from '../components/refined/Cv.astro';

const theme = resolveTheme(Astro.cookies) ?? 'geek';

const title = 'CV — Vasile Pop · 21+ years SDET, Test Automation & Web Development';
const description =
  'Career history of Vasile Pop — SDET, test automation engineer, web developer. Distribusion, ComplyAdvantage, Hopin, LeadIQ, Intel. Python, TypeScript, Playwright, pytest, k6. Open to consulting.';
---

{theme === 'refined' ? (
  <Refined title={title} description={description} active="cv">
    <RefinedCv />
  </Refined>
) : (
  <Terminal title={title} description={description} active="cv">
    <GeekCv />
  </Terminal>
)}
