---
export const prerender = false;

import { resolveTheme } from '../lib/theme';
import Terminal from '../layouts/Terminal.astro';
import Refined from '../layouts/Refined.astro';
import GeekWork from '../components/geek/Work.astro';
import RefinedWork from '../components/refined/Work.astro';

const theme = resolveTheme(Astro.cookies) ?? 'geek';

const title = 'Projects — Web Development & Test Automation by Vasile Pop';
const description =
  'Selected projects by Vasile Pop — production websites in Astro, Next.js and Sanity, plus open-source test automation in Python and TypeScript. Built for clinics, agencies and SaaS teams.';
---

{theme === 'refined' ? (
  <Refined title={title} description={description} active="work">
    <RefinedWork />
  </Refined>
) : (
  <Terminal title={title} description={description} active="work">
    <GeekWork />
  </Terminal>
)}
