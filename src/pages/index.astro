---
export const prerender = false;

import { resolveTheme } from '../lib/theme';
import { HOME_TITLE, HOME_DESCRIPTION, buildHomeJsonLd } from '../lib/seo';
import Gate from '../components/Gate.astro';
import Terminal from '../layouts/Terminal.astro';
import Refined from '../layouts/Refined.astro';
import GeekHome from '../components/geek/Home.astro';
import RefinedHome from '../components/refined/Home.astro';

// No choice yet → show the gate. Otherwise render the chosen home so there's
// no flash of the wrong theme (the cookie is read on the server).
const theme = resolveTheme(Astro.cookies);

const SITE = Astro.site?.toString().replace(/\/$/, '') ?? 'https://www.vicusbass.com';
const jsonLd = buildHomeJsonLd(SITE);
---

{theme === null && <Gate />}

{theme === 'geek' && (
  <Terminal title={HOME_TITLE} description={HOME_DESCRIPTION} active="home" jsonLd={jsonLd}>
    <GeekHome />
  </Terminal>
)}

{theme === 'refined' && (
  <Refined title={HOME_TITLE} description={HOME_DESCRIPTION} active="home" jsonLd={jsonLd}>
    <RefinedHome />
  </Refined>
)}
