---
export const prerender = false;

import { getCollection } from 'astro:content';
import { resolveTheme } from '../../lib/theme';
import Terminal from '../../layouts/Terminal.astro';
import Refined from '../../layouts/Refined.astro';
import GeekPost from '../../components/geek/Post.astro';
import RefinedPost from '../../components/refined/Post.astro';

const { slug } = Astro.params;
const post = (await getCollection('blog')).find((p) => p.id === slug);

if (!post) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

const theme = resolveTheme(Astro.cookies) ?? 'geek';

const isoDate = post.data.pubDate.toISOString();
const SITE = Astro.site?.toString().replace(/\/$/, '') ?? 'https://www.vicusbass.com';
const url = `${SITE}/blog/${post.id}/`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: isoDate,
  author: {
    '@type': 'Person',
    name: 'Vasile Pop',
    url: SITE,
  },
  publisher: {
    '@type': 'Person',
    name: 'Vasile Pop',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': url,
  },
  keywords: post.data.tags?.join(', '),
};
---

{theme === 'refined' ? (
  <Refined
    title={post.data.title}
    description={post.data.description}
    active="blog"
    ogType="article"
    publishedTime={isoDate}
    tags={post.data.tags}
    jsonLd={jsonLd}
  >
    <RefinedPost post={post} />
  </Refined>
) : (
  <Terminal
    title={post.data.title}
    description={post.data.description}
    active="blog"
    ogType="article"
    publishedTime={isoDate}
    tags={post.data.tags}
    jsonLd={jsonLd}
  >
    <GeekPost post={post} />
  </Terminal>
)}
