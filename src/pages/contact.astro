---
export const prerender = false;

import { resolveTheme } from '../lib/theme';
import Terminal from '../layouts/Terminal.astro';
import Refined from '../layouts/Refined.astro';
import GeekContact from '../components/geek/Contact.astro';
import RefinedContact from '../components/refined/Contact.astro';

const theme = resolveTheme(Astro.cookies) ?? 'geek';

const title = 'Contact — Hire Vasile Pop for SDET & Web Development Consulting';
const description =
  'Get in touch with Vasile Pop for SDET consulting, test automation framework setup, end-to-end test strategy audits, technical interviews, or web development. Cluj-Napoca · remote · ~24h reply.';
---

{theme === 'refined' ? (
  <Refined title={title} description={description} active="contact">
    <RefinedContact />
  </Refined>
) : (
  <Terminal title={title} description={description} active="contact">
    <GeekContact />
  </Terminal>
)}
