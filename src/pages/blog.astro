---
export const prerender = false;

import { resolveTheme } from '../lib/theme';
import Terminal from '../layouts/Terminal.astro';
import Refined from '../layouts/Refined.astro';
import GeekWriting from '../components/geek/Writing.astro';
import RefinedWriting from '../components/refined/Writing.astro';

const theme = resolveTheme(Astro.cookies) ?? 'geek';

const title = 'Blog — Notes on Test Automation, SDET & Web Development';
const description =
  'Posts by Vasile Pop on test automation, SDET work, Playwright vs Cypress, pytest, k6 load testing, end-to-end strategy and shipping web apps. Opinions are my own.';
---

{theme === 'refined' ? (
  <Refined title={title} description={description} active="blog">
    <RefinedWriting />
  </Refined>
) : (
  <Terminal title={title} description={description} active="blog">
    <GeekWriting />
  </Terminal>
)}
