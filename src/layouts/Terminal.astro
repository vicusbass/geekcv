---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Head from '../components/Head.astro';
import Boot from '../components/Boot.astro';
import CRTLayers from '../components/CRTLayers.astro';
import TermTop from '../components/TermTop.astro';
import TermFoot from '../components/TermFoot.astro';

interface Props {
  title: string;
  description?: string;
  active?: 'home' | 'services' | 'work' | 'cv' | 'blog' | 'contact';
  /** Pass `null` to opt out of the default social card. */
  ogImage?: string | null;
  /** Pixel dimensions of `ogImage`. Defaults match `/og-default.png` (1200×630). */
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  canonical?: string;
  publishedTime?: string;
  tags?: string[];
  lang?: 'en' | 'ro';
  alternates?: Array<{ hreflang: string; href: string }>;
}

const {
  title,
  description,
  active,
  ogImage,
  ogImageWidth,
  ogImageHeight,
  ogType,
  noindex,
  jsonLd,
  canonical,
  publishedTime,
  tags,
  lang = 'en',
  alternates,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <Head
      title={title}
      description={description}
      ogImage={ogImage}
      ogImageWidth={ogImageWidth}
      ogImageHeight={ogImageHeight}
      ogType={ogType}
      noindex={noindex}
      jsonLd={jsonLd}
      canonical={canonical}
      publishedTime={publishedTime}
      tags={tags}
      lang={lang}
      alternates={alternates}
    />
    <meta name="theme-color" content="#06080a" />

    <Font cssVariable="--font-jetbrains" preload={[{ subset: 'latin' }]} />
    <Font cssVariable="--font-space-mono" preload={[{ weight: 400, subset: 'latin' }]} />
  </head>
  <body>
    <a class="skip-link" href="#main">$ skip to content</a>
    <CRTLayers />
    <TermTop active={active} lang={lang} />
    <main class="term-stage page-enter" id="main" tabindex="-1">
      <slot />
    </main>
    <TermFoot />

    <Boot />

    <script>
      import { formatUptime } from '../lib/uptime';
      const uptime = formatUptime();
      for (const el of document.querySelectorAll<HTMLElement>('[data-uptime]')) {
        el.textContent = uptime;
      }
    </script>
  </body>
</html>
