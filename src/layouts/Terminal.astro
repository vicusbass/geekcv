---
import '../styles/global.css';
import Head from '../components/Head.astro';
import Boot from '../components/Boot.astro';
import CRTLayers from '../components/CRTLayers.astro';
import TermTop from '../components/TermTop.astro';
import TermFoot from '../components/TermFoot.astro';

interface Props {
  title: string;
  description?: string;
  active?: 'home' | 'work' | 'cv' | 'blog' | 'contact';
  /** Pass `null` to opt out of the default social card. */
  ogImage?: string | null;
  /** Pixel dimensions of `ogImage`. Defaults match `/og-default.png` (1200×630). */
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  canonical?: string;
  publishedTime?: string;
  tags?: string[];
}

const {
  title,
  description,
  active,
  ogImage,
  ogImageWidth,
  ogImageHeight,
  ogType,
  noindex,
  jsonLd,
  canonical,
  publishedTime,
  tags,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title={title}
      description={description}
      ogImage={ogImage}
      ogImageWidth={ogImageWidth}
      ogImageHeight={ogImageHeight}
      ogType={ogType}
      noindex={noindex}
      jsonLd={jsonLd}
      canonical={canonical}
      publishedTime={publishedTime}
      tags={tags}
    />
    <meta name="theme-color" content="#06080a" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Space+Mono:wght@400;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Space+Mono:wght@400;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      media="print"
      onload="this.media='all'"
    />
  </head>
  <body>
    <CRTLayers />
    <TermTop active={active} />
    <main class="term-stage page-enter">
      <slot />
    </main>
    <TermFoot />

    <Boot />

    <script>
      import { formatUptime } from '../lib/uptime';
      const uptime = formatUptime();
      for (const el of document.querySelectorAll<HTMLElement>('[data-uptime]')) {
        el.textContent = uptime;
      }
    </script>
  </body>
</html>
