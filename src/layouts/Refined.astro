---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Head from '../components/Head.astro';
import { CONTACT, HOME } from '../lib/home';

interface Props {
  title: string;
  description?: string;
  active?: 'home' | 'services' | 'work' | 'cv' | 'blog' | 'contact';
  ogImage?: string | null;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  canonical?: string;
  publishedTime?: string;
  tags?: string[];
  lang?: 'en' | 'ro';
  alternates?: Array<{ hreflang: string; href: string }>;
}

const {
  title,
  description,
  active,
  ogImage,
  ogImageWidth,
  ogImageHeight,
  ogType,
  noindex,
  jsonLd,
  canonical,
  publishedTime,
  tags,
  lang = 'en',
  alternates,
} = Astro.props;

const year = new Date().getFullYear();

const nav = [
  { id: 'home', href: '/', label: 'Home' },
  { id: 'services', href: '/services', label: 'Services' },
  { id: 'work', href: '/projects', label: 'Work' },
  { id: 'cv', href: '/cv', label: 'CV' },
  { id: 'blog', href: '/blog', label: 'Writing' },
  { id: 'contact', href: '/contact', label: 'Contact' },
] as const;
---

<!doctype html>
<html lang={lang} data-theme="refined">
  <head>
    <Head
      title={title}
      description={description}
      ogImage={ogImage}
      ogImageWidth={ogImageWidth}
      ogImageHeight={ogImageHeight}
      ogType={ogType}
      noindex={noindex}
      jsonLd={jsonLd}
      canonical={canonical}
      publishedTime={publishedTime}
      tags={tags}
      lang={lang}
      alternates={alternates}
    />
    <meta name="theme-color" content="#ffffff" />

    <Font cssVariable="--font-hanken" preload={[{ subset: 'latin' }]} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <!-- utility strip -->
    <div class="rf-utility">
      <div class="rf-shell rf-util">
        <div class="rf-status">
          <span class="dot"></span>
          Open for consulting · 2026
        </div>
        <div class="rf-util-end">
          {lang === 'ro' ? (
            <a class="rf-lang-util" href="/services" hreflang="en" lang="en">English</a>
          ) : (
            <a class="rf-lang-util" href="/ro/servicii" hreflang="ro" lang="ro">{HOME.cta.roLink}</a>
          )}
          <button type="button" class="rf-switch" data-switch-geek>⌘ Geek view ↗</button>
        </div>
      </div>
    </div>

    <!-- header -->
    <header class="rf-header">
      <div class="rf-shell rf-head">
        <a href="/" class="rf-brand">
          <span class="rf-monogram">VP</span>
          <span class="rf-brand-text">
            <span class="rf-brand-name">Vasile Pop</span>
            <span class="rf-brand-sub">SDET · Web Development</span>
          </span>
        </a>
        <nav class="rf-nav">
          {nav.map((it) => (
            <a
              href={it.href}
              class="rf-navlink"
              aria-current={active === it.id ? 'page' : undefined}
            >{it.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main class="rf-shell rf-main" id="main" tabindex="-1">
      <slot />
    </main>

    <!-- footer -->
    <footer class="rf-footer">
      <div class="rf-shell rf-foot">
        <div class="rf-foot-brand">
          <span class="rf-foot-mono" aria-hidden="true">VP</span>
          <span class="rf-foot-copy">© {year} Vasile Pop · Cluj-Napoca</span>
        </div>
        <ul class="rf-foot-links">
          <li><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></li>
          <li><a href={CONTACT.linkedin.href} target="_blank" rel="noreferrer">LinkedIn</a></li>
          <li><a href={CONTACT.github.href} target="_blank" rel="noreferrer">GitHub</a></li>
        </ul>
        <button type="button" class="rf-switch-foot" data-switch-geek>
          Prefer the terminal? Switch to geek view ↗
        </button>
      </div>
    </footer>

    <script>
      // Flip to the geek presentation and reload the current path (both themes
      // share routes, so the visitor stays on the equivalent page).
      const toGeek = () => {
        document.cookie = 'vp-theme=geek;path=/;max-age=31536000;samesite=lax';
        try {
          localStorage.setItem('vp-theme', 'geek');
        } catch {}
        location.reload();
      };
      for (const el of document.querySelectorAll('[data-switch-geek]')) {
        el.addEventListener('click', toGeek);
      }

      // Phones scroll the nav sideways; keep the current page's link in view.
      document
        .querySelector('.rf-nav [aria-current="page"]')
        ?.scrollIntoView({ block: 'nearest', inline: 'center' });
    </script>
  </body>
</html>
