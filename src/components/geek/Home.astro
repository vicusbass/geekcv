---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Me from '../Me.astro';
import Shell from '../Shell.astro';
import { getAsset } from '../../lib/assets';
import { HOME, CONTACT } from '../../lib/home';

const latest = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const thumbs = await Promise.all(
  latest.map(async (p) => {
    const src = getAsset(p.data.shot);
    if (!src) return null;
    const img = await getImage({
      src,
      width: 240,
      format: 'webp',
      quality: 80,
    });
    return img.src;
  }),
);

const { cta } = HOME;
---

<section class="home-hero">
  <div class="home-left">
    <pre class="home-ascii" aria-hidden="true">{`██╗   ██╗██╗ ██████╗██╗   ██╗███████╗██████╗  █████╗ ███████╗███████╗
██║   ██║██║██╔════╝██║   ██║██╔════╝██╔══██╗██╔══██╗██╔════╝██╔════╝
██║   ██║██║██║     ██║   ██║███████╗██████╔╝███████║███████╗███████╗
╚██╗ ██╔╝██║██║     ██║   ██║╚════██║██╔══██╗██╔══██║╚════██║╚════██║
 ╚████╔╝ ██║╚██████╗╚██████╔╝███████║██████╔╝██║  ██║███████║███████║
  ╚═══╝  ╚═╝ ╚═════╝ ╚═════╝ ╚══════╝╚═════╝ ╚═╝  ╚═╝╚══════╝╚══════╝`}</pre>

    <p class="home-pos">
      <span class="home-pos-hash" aria-hidden="true">#</span>
      <span>{HOME.positioning.toLowerCase()}</span>
      <span class="home-online">● online</span>
    </p>

    <h1 class="home-h1">
      {HOME.headline.map((l) => (
        <span class="home-h1-l">{l.pre}<span class="nw"><em>{l.em}</em>{l.post}</span></span>
      ))}
    </h1>
    <p class="home-lead">{HOME.lead}</p>
    <p class="home-avail">{HOME.availability} {HOME.offClock}</p>

    <div class="home-cta">
      <a class="btn btn-prim" href="/contact">$ mail vasile</a>
      <a class="btn" href="/projects">$ open ./work</a>
    </div>

    <dl class="home-stats">
      {HOME.stats.map((s) => (
        <div class="home-stats-row">
          <dt class="home-stats-k">[{s.n}]</dt>
          <dd class="home-stats-v">{s.label}</dd>
        </div>
      ))}
      <div class="home-stats-row">
        <dt class="home-stats-k">[@]</dt>
        <dd class="home-stats-v">{HOME.location.toLowerCase()}</dd>
      </div>
    </dl>
  </div>

  <aside class="home-right">
    <Me />
    <Shell />
  </aside>
</section>

<section class="home-clients" aria-label="Worked with">
  <span class="home-clients-k">[WORKED WITH]</span>
  <ul class="home-clients-list">
    {HOME.clients.map((c) => <li>{c}</li>)}
  </ul>
</section>

<section class="home-sec">
  <div class="term-h home-sec-h">
    <span class="lead">ls -t //</span>
    <h2>~/<em>latest</em></h2>
    <a class="right home-sec-link" href="/projects">{cta.allWork.toLowerCase()}</a>
  </div>
  <p class="home-sec-note"># {cta.workTitle}</p>

  <div class="latest-grid">
    {latest.map((p, i) => (
      <a class="latest-card" href={p.data.url} target="_blank" rel="noreferrer">
        <div class="latest-card-hd">
          <span class="latest-id">./{p.id}</span>
          <span class="latest-yr">{p.data.year}</span>
        </div>
        {thumbs[i] && (
          <div class="latest-thumb" aria-hidden="true">
            <img src={thumbs[i]} alt="" loading="lazy" />
            <span class="latest-thumb-scan"></span>
          </div>
        )}
        <div class="latest-ttl">{p.data.title}</div>
        <p class="latest-blurb">{p.data.blurb}</p>
        <div class="latest-card-ft">
          <span>{p.data.kind}</span>
          <span aria-hidden="true">↗</span>
          <span class="sr-only">{cta.externalNote}</span>
        </div>
      </a>
    ))}
  </div>
</section>

<section class="home-sec">
  <div class="term-h home-sec-h">
    <span class="lead">man vasile //</span>
    <h2>~/<em>help</em></h2>
    <a class="right home-sec-link" href="/services">{cta.allServices.toLowerCase()}</a>
  </div>
  <p class="home-sec-note"># {cta.capsTitle}</p>

  <ul class="caps-grid">
    {HOME.capabilities.map((cap) => (
      <li class="caps-cell">
        <h3 class="caps-ttl">{cap.title}</h3>
        <p class="caps-body">{cap.body}</p>
      </li>
    ))}
  </ul>
</section>

<section class="home-sec" aria-labelledby="home-close-h">
  <div class="term-h home-sec-h">
    <span class="lead">mail //</span>
    <h2>~/<em>contact</em></h2>
    <span class="right">reply · ~1 working day</span>
  </div>

  <div class="win close-win">
    <div class="win-hd">
      <div class="dots"><i></i><i></i><i></i></div>
      <span>~/contact — new message</span>
    </div>
    <div class="close-bd">
      <h3 class="close-h" id="home-close-h">{cta.closeTitle}</h3>
      <p class="close-p">{cta.closeText}</p>
      <div class="close-act">
        <a class="btn btn-prim" href="/contact">$ mail vasile</a>
        <span class="close-mail">
          {cta.emailLabel} <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
        </span>
      </div>
      <ol class="close-steps">
        {HOME.process.map((p) => (
          <li>
            <span class="close-no">[{p.step}]</span>
            <span class="close-ttl">{p.title.toLowerCase()}</span>
            <span class="close-body">{p.body}</span>
          </li>
        ))}
      </ol>
      <a class="close-ro" href="/ro/servicii" hreflang="ro" lang="ro">$ cd /ro/servicii <span class="close-ro-l">· {cta.roLink}</span></a>
    </div>
  </div>
</section>

<style>
  .home-hero {
    padding: 48px 24px 32px;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 32px;
    align-items: start;
  }
  .home-left {
    min-width: 0;
  }
  .home-ascii {
    color: var(--term-accent);
    text-shadow: 0 0 12px rgba(var(--term-accent-rgb), 0.4);
    font-size: 10.5px;
    line-height: 1.1;
    margin: 0;
    font-weight: 500;
    overflow: hidden;
  }
  @media (max-width: 720px) {
    .home-ascii {
      display: none;
    }
  }
  .home-pos {
    margin: 18px 0 0;
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--term-accent);
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: baseline;
  }
  .home-pos-hash {
    color: var(--term-dim);
  }
  .home-online {
    color: var(--term-dim);
    font-size: 11.5px;
  }
  .home-h1 {
    font-family: var(--term-display);
    font-size: 36px;
    line-height: 1.25;
    letter-spacing: -0.01em;
    font-weight: 500;
    color: var(--term-fg);
    margin: 22px 0 12px;
  }
  .home-h1-l {
    display: block;
  }
  .home-h1 .nw {
    white-space: nowrap;
  }
  .home-h1 em {
    font-style: normal;
    color: var(--term-accent);
    background: rgba(var(--term-accent-rgb), 0.1);
    padding: 0 6px;
    border-radius: 3px;
    text-shadow: 0 0 12px rgba(var(--term-accent-rgb), 0.4);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .home-lead {
    max-width: 60ch;
    color: var(--term-dim);
    font-size: 14px;
    line-height: 1.6;
    margin: 12px 0 0;
  }
  .home-avail {
    max-width: 60ch;
    color: var(--term-fg);
    font-size: 13.5px;
    line-height: 1.6;
    margin: 10px 0 24px;
  }
  .home-cta {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }
  .home-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    row-gap: 6px;
    column-gap: 24px;
    font-size: 12.5px;
    color: var(--term-dim);
    border-top: 1px dashed var(--term-line);
    padding-top: 16px;
    margin: 0;
  }
  .home-stats-row {
    display: grid;
    grid-template-columns: 5ch 1fr;
    gap: 10px;
  }
  .home-stats-k {
    color: var(--term-accent);
    font-variant-numeric: tabular-nums;
  }
  .home-stats-v {
    color: var(--term-fg);
    margin: 0;
  }

  .home-right {
    position: sticky;
    top: 80px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }

  /* clients */
  .home-clients {
    margin: 0 24px;
    padding: 14px 0;
    border-top: 1px solid var(--term-line);
    border-bottom: 1px solid var(--term-line);
    display: flex;
    gap: 10px 18px;
    flex-wrap: wrap;
    align-items: baseline;
    font-size: 12.5px;
  }
  .home-clients-k {
    color: var(--term-dim);
    font-size: 11.5px;
    letter-spacing: 0.06em;
  }
  .home-clients-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    color: var(--term-fg);
  }
  .home-clients-list li + li::before {
    content: '·';
    color: var(--term-dim);
    margin-right: 18px;
  }

  /* section scaffolding */
  .home-sec {
    padding: 0 24px;
  }
  .home-sec-h {
    padding: 48px 0 16px;
  }
  .home-sec-link {
    color: var(--term-dim);
    opacity: 1;
    text-decoration: none;
    border-bottom: 1px dashed var(--term-line-strong);
  }
  .home-sec-link:hover {
    color: var(--term-accent);
    border-color: var(--term-accent);
  }
  .home-sec-note {
    margin: 14px 0 0;
    color: var(--term-dim);
    font-size: 12.5px;
  }

  /* latest */
  .latest-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--term-line);
    border: 1px solid var(--term-line);
    margin-top: 16px;
  }
  .latest-card {
    background: var(--term-bg);
    padding: 20px 18px;
    text-decoration: none;
    color: var(--term-fg);
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 180px;
    position: relative;
    transition: background 0.15s;
  }
  .latest-card:hover {
    background: rgba(var(--term-accent-rgb), 0.06);
  }
  .latest-card:focus-visible {
    outline-offset: -2px;
  }
  .latest-card-hd {
    display: flex;
    justify-content: space-between;
    font-size: 11.5px;
    color: var(--term-dim);
  }
  .latest-id {
    color: var(--term-accent);
  }
  .latest-yr {
    font-variant-numeric: tabular-nums;
  }
  .latest-thumb {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--term-line);
    background: var(--term-bg-2);
  }
  .latest-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
    filter: saturate(0.75) contrast(1.05) brightness(0.95);
  }
  .latest-thumb-scan {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(180deg, transparent 0 2px, rgba(0, 0, 0, 0.25) 3px);
    mix-blend-mode: multiply;
    opacity: 0.5;
  }
  .latest-card:hover .latest-thumb {
    border-color: var(--term-line-strong);
  }
  .latest-card:hover .latest-thumb img {
    filter: saturate(0.9) contrast(1.1) brightness(1);
  }
  .latest-ttl {
    font-family: var(--term-display);
    font-size: 22px;
    letter-spacing: -0.01em;
    margin-top: 4px;
    color: var(--term-fg);
  }
  .latest-card:hover .latest-ttl {
    color: var(--term-accent);
    text-shadow: 0 0 8px rgba(var(--term-accent-rgb), 0.3);
  }
  .latest-blurb {
    margin: 0;
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--term-dim);
  }
  .latest-card-ft {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    font-size: 11.5px;
    color: var(--term-dim);
  }

  /* capabilities */
  .caps-grid {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--term-line);
    border: 1px solid var(--term-line);
  }
  .caps-cell {
    background: var(--term-bg);
    padding: 22px 20px;
  }
  .caps-ttl {
    font-family: var(--term-display);
    font-weight: 400;
    font-size: 18px;
    letter-spacing: -0.01em;
    color: var(--term-fg);
    margin: 0;
  }
  .caps-ttl::before {
    content: '> ';
    color: var(--term-accent);
  }
  .caps-body {
    margin: 10px 0 0;
    font-size: 13px;
    line-height: 1.6;
    color: var(--term-dim);
    max-width: 48ch;
  }

  /* close */
  .win {
    border: 1px solid var(--term-line-strong);
    background: rgba(0, 0, 0, 0.5);
    border-radius: 4px;
  }
  .win-hd {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    border-bottom: 1px solid var(--term-line);
    font-size: 11px;
    color: var(--term-dim);
    letter-spacing: 0.04em;
  }
  .win-hd .dots {
    display: flex;
    gap: 5px;
  }
  .win-hd .dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    display: inline-block;
  }
  .win-hd .dots i:nth-child(1) {
    background: var(--term-error);
  }
  .win-hd .dots i:nth-child(2) {
    background: var(--term-warn);
  }
  .win-hd .dots i:nth-child(3) {
    background: var(--term-accent);
  }
  .close-win {
    margin-top: 16px;
  }
  .close-bd {
    padding: 26px 24px 22px;
  }
  .close-h {
    font-family: var(--term-display);
    font-weight: 400;
    font-size: 28px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--term-fg);
    margin: 0;
  }
  .close-p {
    margin: 10px 0 0;
    color: var(--term-dim);
    font-size: 14px;
    max-width: 60ch;
  }
  .close-act {
    margin-top: 20px;
    display: flex;
    align-items: center;
    gap: 10px 18px;
    flex-wrap: wrap;
  }
  .close-mail {
    font-size: 13px;
    color: var(--term-dim);
  }
  .close-mail a {
    color: var(--term-fg);
    text-decoration: none;
    border-bottom: 1px dashed var(--term-line-strong);
  }
  .close-mail a:hover {
    color: var(--term-accent);
    border-color: var(--term-accent);
  }
  .close-steps {
    list-style: none;
    margin: 26px 0 0;
    padding: 16px 0 0;
    border-top: 1px dashed var(--term-line);
    display: grid;
    gap: 8px;
    font-size: 13px;
  }
  .close-steps li {
    display: grid;
    grid-template-columns: 5ch 8ch 1fr;
    gap: 12px;
    align-items: baseline;
  }
  .close-no {
    color: var(--term-dim);
    font-variant-numeric: tabular-nums;
  }
  .close-ttl {
    color: var(--term-accent);
  }
  .close-body {
    color: var(--term-fg);
  }
  .close-ro {
    display: inline-block;
    margin-top: 20px;
    font-size: 12.5px;
    color: var(--term-accent);
    text-decoration: none;
  }
  .close-ro-l {
    color: var(--term-dim);
  }
  .close-ro:hover .close-ro-l {
    color: var(--term-accent);
  }

  @media (max-width: 1100px) {
    .home-hero {
      grid-template-columns: 1fr;
    }
    .home-right {
      position: static;
    }
  }
  @media (max-width: 900px) {
    .latest-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .caps-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .home-hero {
      padding: 32px 16px 24px;
    }
    .home-clients {
      margin: 0 16px;
    }
    .home-sec {
      padding: 0 16px;
    }
    .home-sec-h {
      padding: 32px 0 14px;
      grid-template-columns: auto 1fr auto;
    }
    .home-sec-h .home-sec-link {
      display: inline;
    }
    .close-bd {
      padding: 20px 16px 18px;
    }
    .close-h {
      font-size: 22px;
    }
    .close-steps li {
      grid-template-columns: 5ch 1fr;
    }
    .close-body {
      grid-column: 2;
    }
  }
  @media (max-width: 520px) {
    .latest-grid {
      grid-template-columns: 1fr;
    }
    .home-h1 {
      font-size: 26px;
    }
    .home-stats {
      grid-template-columns: 1fr;
    }
  }
</style>
