---
// Interactive terminal — command history, j/k recall, route nav, bass --play easter egg.
---

<div class="win shell">
  <div class="win-hd">
    <div class="dots"><i></i><i></i><i></i></div>
    <span class="shell-title">~/vicusbass — zsh</span>
    <span class="shell-clock" data-shell-clock>--:--:--</span>
  </div>
  <div class="shell-bd">
    <div class="shell-history" data-shell-history role="log" aria-live="polite" aria-label="Terminal output">
      <div class="shell-line shell-sys"><span class="shell-glyph">#</span><span>vicusbass.os v2.6.0 — type `help` for commands</span></div>
      <div class="shell-line shell-sys"><span class="shell-glyph">#</span><span>tip: try `bass --play`, `cv`, `projects`, `whoami`</span></div>
    </div>
    <pre class="shell-bass" data-shell-bass aria-hidden="true" hidden></pre>
    <div class="shell-input-row">
      <span class="shell-glyph shell-prompt" aria-hidden="true">$</span>
      <input
        type="text"
        class="shell-input"
        aria-label="Terminal command"
        data-shell-input
        placeholder="type `help` and press enter"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
      />
    </div>
    <div class="shell-hint" aria-hidden="true">
      <span>↑/↓ history</span>
      <span>tab to complete</span>
      <span>try: <em>bass --play</em></span>
    </div>
  </div>
</div>

<script>
  type LineKind = 'sys' | 'in' | 'out' | 'err';

  const MANIFESTO =
    'I build, test and break software for a living. I write Python and TypeScript, design end-to-end test strategies, and ship the occasional side project. Off the clock I play bass and raise two small humans.';

  const ROUTES: Record<string, string> = {
    services: '/services',
    hire: '/contact',
    projects: '/projects',
    work: '/projects',
    cv: '/cv',
    resume: '/cv',
    blog: '/blog',
    writing: '/blog',
    contact: '/contact',
    'hire vasile': '/contact',
    home: '/',
  };

  // Everything `run` understands, in the order Tab offers it.
  const COMMANDS = [
    'help',
    'whoami',
    'ls',
    'cat about.txt',
    'services',
    'projects',
    'cv',
    'blog',
    'contact',
    'hire vasile',
    'home',
    'bass --play',
    'date',
    'clear',
  ];

  const BASS_FRAMES = [
    '  ♪  ┊┊┃┊┊┃┊┊  ──── G ────  ',
    '    ♬┊┊┃┊┊┃┊┊──── D ────  ',
    '  ♪┊┊┃♫┊┃┊┊  ──── A ─♪──  ',
    '  ┊┊┃┊♬┃┊┊  ──── E ──────  ',
    '  ┊♪┃┊┊┃♫┊  ──── G ───♪──  ',
    '  ┊┊┃♪┊┃┊♬  ──── D ──────  ',
    '  ┊┊┃┊┊♫┊┊  ──── A ──♬───  ',
    '  ♪┊┃┊┊┃♪┊  ── thump ─♪─  ',
  ];

  const root = document.querySelector<HTMLElement>('.shell');
  if (root) {
    const history = root.querySelector<HTMLDivElement>('[data-shell-history]')!;
    const input = root.querySelector<HTMLInputElement>('[data-shell-input]')!;
    const bassEl = root.querySelector<HTMLElement>('[data-shell-bass]')!;
    const clock = root.querySelector<HTMLElement>('[data-shell-clock]')!;
    const scrollHost = root.querySelector<HTMLElement>('.shell-bd')!;

    // Cluj time, matching the header clock.
    const clockFmt = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Europe/Bucharest',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false,
    });
    const tick = () => {
      clock.textContent = clockFmt.format(new Date());
    };
    tick();
    setInterval(tick, 1000);

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const scrollToEnd = () => {
      scrollHost.scrollTop = scrollHost.scrollHeight;
    };

    const stack: string[] = [];
    let stackIdx = -1;
    let bassTimer: number | null = null;

    const GLYPH: Record<LineKind, string> = { in: '$', sys: '#', err: '!', out: ' ' };

    const push = (kind: LineKind, text: string) => {
      const row = document.createElement('div');
      row.className = `shell-line shell-${kind}`;
      const glyph = document.createElement('span');
      glyph.className = 'shell-glyph';
      glyph.textContent = GLYPH[kind];
      const body = document.createElement('span');
      body.textContent = text;
      row.append(glyph, body);
      history.appendChild(row);
      scrollToEnd();
    };

    // Multi-line output lands as one node, so the live log announces it once
    // instead of line by line.
    const pushBlock = (lines: string[]) => {
      const block = document.createElement('div');
      for (const text of lines) {
        const row = document.createElement('div');
        row.className = 'shell-line shell-out';
        const glyph = document.createElement('span');
        glyph.className = 'shell-glyph';
        glyph.textContent = GLYPH.out;
        const body = document.createElement('span');
        body.textContent = text;
        row.append(glyph, body);
        block.appendChild(row);
      }
      history.appendChild(block);
      scrollToEnd();
    };

    const playBass = () => {
      if (bassTimer) {
        window.clearInterval(bassTimer);
        window.clearTimeout(bassTimer);
      }
      bassEl.hidden = false;
      bassEl.textContent = `♪ bass --play  ▶  4-string walking bass\n${BASS_FRAMES[0]}`;
      scrollToEnd();
      // Reduced motion: hold one still frame for a few seconds, no animation.
      if (reduceMotion.matches) {
        bassTimer = window.setTimeout(() => {
          bassTimer = null;
          bassEl.hidden = true;
        }, 4000);
        return;
      }
      let i = 0;
      const frames = 32;
      bassTimer = window.setInterval(() => {
        i++;
        if (i >= frames) {
          window.clearInterval(bassTimer!);
          bassTimer = null;
          bassEl.hidden = true;
          return;
        }
        bassEl.textContent = `♪ bass --play  ▶  4-string walking bass\n${BASS_FRAMES[i % BASS_FRAMES.length]}`;
      }, 180);
    };

    const run = (raw: string) => {
      const c = raw.trim();
      if (!c) return;
      stack.unshift(c);
      stackIdx = -1;
      push('in', c);
      const lower = c.toLowerCase();

      if (lower === 'help') {
        pushBlock([
          'available commands:',
          '  whoami            who is using this terminal',
          '  ls                list directory',
          '  cat about.txt     who I am, in prose',
          '  services          what I can build for you',
          '  projects          go to /projects',
          '  cv                go to /cv',
          '  blog              go to /blog',
          '  contact           go to /contact',
          '  bass --play       ♪ ♫',
          '  date              current date/time',
          '  clear             clear screen',
        ]);
        return;
      }
      if (lower === 'whoami') return push('out', 'vasile · sdet · cluj-napoca · open for consulting');
      if (lower === 'ls' || lower === 'ls -la') {
        pushBlock([
          'total 6',
          'drwxr-xr-x  vasile  staff   home/      -> /',
          'drwxr-xr-x  vasile  staff   services/  -> /services',
          'drwxr-xr-x  vasile  staff   work/      -> /projects',
          'drwxr-xr-x  vasile  staff   cv/        -> /cv',
          'drwxr-xr-x  vasile  staff   blog/      -> /blog',
          'drwxr-xr-x  vasile  staff   contact/   -> /contact',
        ]);
        return;
      }
      if (lower === 'cat about.txt' || lower === 'about') return push('out', MANIFESTO);
      if (lower in ROUTES) {
        push('out', `-> navigating to ${ROUTES[lower]}`);
        window.setTimeout(() => {
          window.location.href = ROUTES[lower];
        }, 250);
        return;
      }
      if (lower === 'bass --play' || lower === 'bass') {
        push('out', '♪ playing /home/vasile/loops/walking-bass.mid ...');
        playBass();
        return;
      }
      if (lower === 'date') return push('out', new Date().toString());
      if (lower === 'clear') {
        history.replaceChildren();
        return;
      }
      if (lower.startsWith('sudo'))
        return push('err', 'vasile is not in the sudoers file. this incident has been reported.');
      if (lower === 'exit' || lower === 'quit') return push('out', 'nice try. there is no exit.');
      push('err', `zsh: command not found: ${c}. try \`help\`.`);
    };

    // Tab completion: the first Tab completes what was typed, further Tabs
    // cycle through the other matches. An empty or unmatched prompt lets Tab
    // move focus as usual, so keyboard users are never trapped in the shell.
    let tabSeed: string | null = null;
    let tabIdx = -1;
    // Typing, pasting or autofill starts a fresh completion. Setting .value
    // from the Tab handler does not fire `input`, so cycling survives.
    input.addEventListener('input', () => {
      tabSeed = null;
      tabIdx = -1;
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Tab' && !e.shiftKey && !e.altKey && !e.ctrlKey && !e.metaKey) {
        const seed = (tabSeed ?? input.value).trimStart().toLowerCase();
        const matches = seed ? COMMANDS.filter((cmd) => cmd.startsWith(seed)) : [];
        if (!matches.length) return;
        e.preventDefault();
        tabSeed = seed;
        tabIdx = (tabIdx + 1) % matches.length;
        input.value = matches[tabIdx];
        return;
      }
      tabSeed = null;
      tabIdx = -1;

      if (e.key === 'Enter') {
        run(input.value);
        input.value = '';
      } else if (e.key === 'ArrowUp') {
        if (!stack.length) return;
        e.preventDefault();
        stackIdx = Math.min(stackIdx + 1, stack.length - 1);
        input.value = stack[stackIdx] ?? '';
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        stackIdx = Math.max(stackIdx - 1, -1);
        input.value = stackIdx < 0 ? '' : stack[stackIdx];
      }
    });

    // Click anywhere in the shell body to focus the input. Not on touch
    // screens: there a tap meant to scroll would pop up the keyboard.
    const coarse = window.matchMedia('(pointer: coarse)');
    scrollHost.addEventListener('click', (e) => {
      if (coarse.matches) return;
      if ((e.target as HTMLElement).tagName !== 'INPUT') input.focus();
    });
  }
</script>

<style>
  .shell {
    transition: border-color 0.15s;
    border: 1px solid var(--term-line-strong);
    background: rgba(0, 0, 0, 0.5);
    border-radius: 4px;
    font-family: var(--term-mono);
    box-shadow: 0 0 24px rgba(var(--term-accent-rgb), 0.05);
  }
  /* The input drops its outline; the whole window carries focus instead. */
  .shell:focus-within {
    border-color: var(--term-accent);
  }
  .win-hd {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    border-bottom: 1px solid var(--term-line);
    font-size: 11px;
    color: var(--term-dim);
    letter-spacing: 0.04em;
  }
  .win-hd .dots {
    display: flex;
    gap: 5px;
  }
  .win-hd .dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #444;
    display: inline-block;
  }
  .win-hd .dots i:nth-child(1) {
    background: var(--term-error);
  }
  .win-hd .dots i:nth-child(2) {
    background: var(--term-warn);
  }
  .win-hd .dots i:nth-child(3) {
    background: var(--term-accent);
  }
  .shell-title {
    flex: 1;
  }
  .shell-clock {
    color: var(--term-accent);
    font-variant-numeric: tabular-nums;
  }

  .shell-bd {
    padding: 14px 16px;
    max-height: 480px;
    overflow: auto;
    font-size: 12.5px;
    cursor: text;
  }
  /* History rows are created by the script below, so they never receive
     Astro's scope attribute: reach them through the scoped .shell root. */
  .shell :global(.shell-line) {
    display: flex;
    gap: 8px;
    white-space: pre-wrap;
    word-break: break-word;
    color: var(--term-fg);
    line-height: 1.5;
  }
  .shell :global(.shell-line.shell-out) {
    padding-left: 14px;
  }
  .shell :global(.shell-line.shell-sys),
  .shell :global(.shell-line.shell-sys .shell-glyph) {
    color: var(--term-dim);
  }
  .shell :global(.shell-line.shell-in .shell-glyph) {
    color: var(--term-accent);
  }
  .shell :global(.shell-line.shell-err),
  .shell :global(.shell-line.shell-err .shell-glyph) {
    color: var(--term-warn);
  }
  .shell :global(.shell-glyph) {
    display: inline-block;
    width: 1ch;
    flex: none;
  }

  .shell-bass {
    margin: 10px 0 0;
    padding: 10px 12px;
    border: 1px solid var(--term-line-strong);
    border-radius: 3px;
    background: rgba(var(--term-accent-rgb), 0.06);
    color: var(--term-accent);
    font-size: 12px;
    white-space: pre;
    text-shadow: 0 0 8px rgba(var(--term-accent-rgb), 0.3);
  }

  .shell-input-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-top: 10px;
    border-top: 1px dashed var(--term-line);
    margin-top: 10px;
  }
  .shell-input-row .shell-glyph {
    color: var(--term-accent);
  }
  .shell-input {
    flex: 1;
    background: transparent;
    border: 0;
    color: var(--term-fg);
    font: inherit;
    outline: none;
    caret-color: var(--term-accent);
  }
  .shell-input::placeholder {
    color: var(--term-dim);
    opacity: 0.6;
  }

  .shell-hint {
    margin-top: 8px;
    font-size: 11px;
    color: var(--term-dim);
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .shell-hint em {
    font-style: normal;
    color: var(--term-accent);
  }
</style>
