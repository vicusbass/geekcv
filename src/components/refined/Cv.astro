---
import { getCollection, render } from 'astro:content';

const jobs = (await getCollection('job')).slice();

const monthToNum: Record<string, number> = {
  jan: 0, feb: 1, mar: 2, apr: 3, may: 4, jun: 5,
  jul: 6, aug: 7, sep: 8, oct: 9, nov: 10, dec: 11,
};

const parseStart = (s: string): number => {
  const [mon, year] = s.toLowerCase().trim().split(/\s+/);
  const m = monthToNum[mon?.slice(0, 3) ?? ''] ?? 0;
  const y = Number(year ?? mon);
  if (!Number.isFinite(y)) return 0;
  return new Date(y, m, 1).getTime();
};

jobs.sort((a, b) => parseStart(b.data.startDate) - parseStart(a.data.startDate));

const rendered = await Promise.all(
  jobs.map(async (j) => {
    const { Content } = await render(j);
    return { job: j, Content };
  }),
);

const formatPeriod = (start: string, end?: string) => `${start} — ${end ?? 'Now'}`;

const skillGroups = [
  { label: 'Test automation', items: ['Playwright', 'pytest', 'Cypress', 'k6.io', 'TestCafe', 'Selenium', 'Appium', 'Karate'] },
  { label: 'Languages', items: ['Python', 'TypeScript', 'JavaScript', 'Java', 'Ruby'] },
  { label: 'Web', items: ['React', 'Next.js', 'Astro', 'Vue', 'Tailwind', 'Sanity', 'Shopify'] },
  { label: 'Infra & CI/CD', items: ['Docker', 'k8s', 'GitHub Actions', 'GitLab CI', 'AWS', 'Postgres', 'Kafka'] },
];
---

<div class="rf-page">
  <section class="rf-cv-header">
    <div>
      <div class="rf-kicker">Curriculum vitae</div>
      <h1 class="rf-h1">21 years, in order</h1>
    </div>
    <div class="rf-cv-status">Cluj-Napoca · remote · <span>open for consulting</span></div>
  </section>

  <div class="rf-cv">
    <!-- timeline -->
    <div>
      {rendered.map(({ job, Content }) => (
        <article class="rf-cvrow">
          <div class="rf-cv-period">{formatPeriod(job.data.startDate, job.data.endDate)}</div>
          <div class="rf-cv-entry">
            <span class="rf-cv-dot"></span>
            <h3 class="rf-cv-role">{job.data.title}</h3>
            <div class="rf-cv-company">
              {job.data.companyUrl ? (
                <a href={job.data.companyUrl} target="_blank" rel="noreferrer">{job.data.company}</a>
              ) : job.data.company}
            </div>
            <div class="rf-cv-prose"><Content /></div>
          </div>
        </article>
      ))}
    </div>

    <!-- rail -->
    <aside class="rf-cv-rail">
      <div class="rf-cv-card">
        <div class="rf-cv-card-title">Skills</div>
        {skillGroups.map((g) => (
          <div class="rf-cv-group">
            <div class="rf-cv-group-label">{g.label}</div>
            <div class="rf-cv-group-pills">
              {g.items.map((s) => <span class="rf-pill">{s}</span>)}
            </div>
          </div>
        ))}
      </div>
      <div class="rf-cv-card">
        <div class="rf-cv-card-title">Off the clock</div>
        <p class="rf-cv-card-text">
          Bass guitar, a few six-strings, and raising two small humans. The
          walking basslines and the regression suites have more in common than
          you'd think.
        </p>
      </div>
    </aside>
  </div>
</div>

<style>
  .rf-page {
    animation: vp-fade 0.5s ease both;
  }
  .rf-cv-header {
    padding: 64px 0 40px;
    border-bottom: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    flex-wrap: wrap;
  }
  .rf-h1 {
    font-family: var(--display);
    font-weight: var(--h-weight);
    font-size: clamp(34px, 4.6vw, 54px);
    color: var(--fg);
    margin: 16px 0 0;
    letter-spacing: var(--h-ls);
  }
  .rf-cv-status {
    font-size: 13px;
    color: var(--muted);
  }
  .rf-cv-status span {
    color: var(--accent);
  }

  .rf-cv {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 56px;
    padding-top: 44px;
    align-items: start;
  }

  .rf-cvrow {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 22px;
    padding: 0 0 30px;
    position: relative;
  }
  .rf-cv-period {
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.02em;
    padding-top: 4px;
  }
  .rf-cv-entry {
    border-left: 1px solid var(--line);
    padding: 0 0 4px 24px;
    position: relative;
  }
  .rf-cv-dot {
    position: absolute;
    left: -5px;
    top: 6px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
  }
  .rf-cv-role {
    font-family: var(--display);
    font-weight: 700;
    font-size: 20px;
    color: var(--fg);
    margin: 0;
    letter-spacing: var(--h-ls);
  }
  .rf-cv-company {
    font-size: 13.5px;
    color: var(--accent);
    font-weight: 700;
    margin-top: 3px;
  }
  .rf-cv-company a {
    color: var(--accent);
    text-decoration: none;
  }
  .rf-cv-company a:hover {
    text-decoration: underline;
  }
  .rf-cv-prose :global(p) {
    font-size: 13.5px;
    color: var(--muted);
    line-height: 1.6;
    margin: 9px 0 0;
  }
  .rf-cv-prose :global(ul) {
    margin: 10px 0 0;
    padding-left: 16px;
  }
  .rf-cv-prose :global(li) {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.55;
    margin: 4px 0;
  }
  .rf-cv-prose :global(li::marker) {
    color: var(--accent);
  }
  .rf-cv-prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .rf-cv-prose :global(a:hover) {
    text-decoration: none;
  }

  .rf-cv-rail {
    position: sticky;
    top: 96px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .rf-cv-card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 22px;
  }
  .rf-cv-card-title {
    font-family: var(--display);
    font-weight: 700;
    font-size: 16px;
    color: var(--fg);
    margin-bottom: 16px;
    letter-spacing: var(--h-ls);
  }
  .rf-cv-group {
    margin-bottom: 16px;
  }
  .rf-cv-group:last-child {
    margin-bottom: 0;
  }
  .rf-cv-group-label {
    font-size: 11px;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    margin-bottom: 8px;
  }
  .rf-cv-group-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .rf-cv-card-text {
    font-size: 13.5px;
    color: var(--muted);
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 980px) {
    .rf-cv {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .rf-cv-rail {
      position: static;
    }
  }
  @media (max-width: 640px) {
    .rf-cvrow {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
