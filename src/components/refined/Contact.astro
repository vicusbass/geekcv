---
const EMAIL = 'vasile.pop@gmail.com';
const LINKEDIN = 'https://www.linkedin.com/in/vasilepop/';
const GITHUB = 'https://github.com/vicusbass';

const contacts = [
  { label: 'Email', value: EMAIL, note: 'Preferred · ~24h reply', href: `mailto:${EMAIL}` },
  { label: 'LinkedIn', value: '/in/vasilepop', note: 'Professional · slow but I read', href: LINKEDIN },
  { label: 'GitHub', value: '@vicusbass', note: 'Code · open issues welcome', href: GITHUB },
  { label: 'Location', value: 'Cluj-Napoca, RO', note: '46.77° N · remote-friendly', href: null },
];
---

<div class="rf-page">
  <section class="rf-header-sec">
    <div class="rf-kicker">Contact</div>
    <h1 class="rf-h1">Let's talk</h1>
    <p class="rf-intro">
      Consulting, framework setup, technical interviews, tricky QA audits, or a
      web build. I usually reply within a working day.
    </p>
  </section>

  <div class="rf-contact">
    <!-- form card -->
    <div class="rf-form-card" data-contact-card>
      <form class="rf-contact-form" data-contact-form novalidate>
        <div class="rf-form2">
          <label class="rf-field">
            <span class="rf-field-label">Name</span>
            <input class="rf-input" type="text" name="name" required maxlength="120" autocomplete="name" placeholder="Your name" />
          </label>
          <label class="rf-field">
            <span class="rf-field-label">Email</span>
            <input class="rf-input" type="email" name="email" required maxlength="254" autocomplete="email" placeholder="you@email.com" />
          </label>
        </div>
        <label class="rf-field rf-field-block">
          <span class="rf-field-label">Subject</span>
          <input class="rf-input" type="text" name="subject" maxlength="200" placeholder="What's this about?" />
        </label>
        <label class="rf-field rf-field-block">
          <span class="rf-field-label">Message</span>
          <textarea class="rf-input rf-textarea" name="body" rows="6" required maxlength="5000" placeholder="Tell me about the stack you'd like help with…"></textarea>
        </label>
        <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" class="rf-hp" />
        <p class="rf-form-error" data-form-error hidden>
          Couldn't send — please email <a href={`mailto:${EMAIL}`}>{EMAIL}</a> directly.
        </p>
        <button type="submit" class="rf-btn rf-btn-primary rf-send">Send message →</button>
      </form>

      <div class="rf-contact-success" data-contact-success hidden>
        <div class="rf-success-check">✓</div>
        <div class="rf-success-title">Message sent</div>
        <p class="rf-success-text">Thanks — I'll get back to you within a working day.</p>
        <button type="button" class="rf-textlink" data-send-another>Send another →</button>
      </div>
    </div>

    <!-- contact cards -->
    <aside class="rf-contact-cards">
      {contacts.map((ct) => (
        ct.href ? (
          <a class="rf-contact-card" href={ct.href} target="_blank" rel="noreferrer">
            <div class="rf-contact-label">{ct.label}</div>
            <div class="rf-contact-value">{ct.value}</div>
            <div class="rf-contact-note">{ct.note}</div>
          </a>
        ) : (
          <div class="rf-contact-card">
            <div class="rf-contact-label">{ct.label}</div>
            <div class="rf-contact-value">{ct.value}</div>
            <div class="rf-contact-note">{ct.note}</div>
          </div>
        )
      ))}
    </aside>
  </div>
</div>

<script is:inline>
  const card = document.querySelector('[data-contact-card]');
  if (card) {
    const form = card.querySelector('[data-contact-form]');
    const success = card.querySelector('[data-contact-success]');
    const errorEl = form.querySelector('[data-form-error]');
    const submitBtn = form.querySelector('button[type="submit"]');
    const againBtn = success.querySelector('[data-send-another]');
    let inFlight = false;

    const send = async (e) => {
      e.preventDefault();
      if (inFlight) return;
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const fd = new FormData(form);
      const payload = {
        name: (fd.get('name') ?? '').toString().trim(),
        email: (fd.get('email') ?? '').toString().trim(),
        subject: (fd.get('subject') ?? '').toString().trim(),
        body: (fd.get('body') ?? '').toString(),
        company: (fd.get('company') ?? '').toString(),
      };

      inFlight = true;
      submitBtn.disabled = true;
      const label = submitBtn.textContent;
      submitBtn.textContent = 'Sending…';
      errorEl.hidden = true;

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => ({ ok: false }));
        if (res.ok && data.ok) {
          form.reset();
          form.hidden = true;
          success.hidden = false;
        } else {
          errorEl.hidden = false;
        }
      } catch {
        errorEl.hidden = false;
      } finally {
        inFlight = false;
        submitBtn.disabled = false;
        submitBtn.textContent = label;
      }
    };

    form.addEventListener('submit', send);
    againBtn?.addEventListener('click', () => {
      success.hidden = true;
      form.hidden = false;
    });
  }
</script>

<style>
  .rf-page {
    animation: vp-fade 0.5s ease both;
  }
  .rf-header-sec {
    padding: 64px 0 40px;
    border-bottom: 1px solid var(--line);
  }
  .rf-h1 {
    font-family: var(--display);
    font-weight: var(--h-weight);
    font-size: clamp(34px, 4.6vw, 54px);
    color: var(--fg);
    margin: 16px 0 0;
    letter-spacing: var(--h-ls);
  }
  .rf-intro {
    color: var(--muted);
    font-size: 16px;
    line-height: 1.6;
    max-width: 54ch;
    margin: 16px 0 0;
  }

  .rf-contact {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 48px;
    padding-top: 44px;
    align-items: start;
  }

  /* form */
  .rf-form-card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 30px 32px;
  }
  .rf-form2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .rf-field {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .rf-field-block {
    margin-top: 18px;
  }
  .rf-field-label {
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .rf-input {
    font: inherit;
    font-size: 14px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 11px 13px;
    color: var(--fg);
    outline: none;
    transition: border-color 0.15s;
  }
  .rf-input:focus {
    border-color: var(--accent);
  }
  .rf-textarea {
    resize: vertical;
    line-height: 1.6;
    padding: 12px 13px;
  }
  .rf-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
  .rf-form-error {
    margin: 18px 0 0;
    font-size: 13px;
    color: var(--accent);
  }
  .rf-form-error a {
    color: var(--accent);
    font-weight: 700;
  }
  .rf-send {
    margin-top: 22px;
    border: 1px solid var(--accent);
  }

  /* success */
  .rf-contact-success {
    padding: 28px 4px;
    text-align: center;
  }
  .rf-success-check {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    display: grid;
    place-items: center;
    font-size: 24px;
    margin: 0 auto 16px;
  }
  .rf-success-title {
    font-family: var(--display);
    font-weight: 700;
    font-size: 22px;
    color: var(--fg);
    letter-spacing: var(--h-ls);
  }
  .rf-success-text {
    font-size: 14px;
    color: var(--muted);
    margin: 10px 0 18px;
  }

  /* contact cards */
  .rf-contact-cards {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .rf-contact-card {
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 18px 20px;
    transition: border-color 0.2s;
    display: block;
  }
  a.rf-contact-card:hover {
    border-color: var(--accent);
  }
  .rf-contact-label {
    font-size: 11px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .rf-contact-value {
    font-family: var(--display);
    font-weight: 700;
    font-size: 17px;
    color: var(--fg);
    margin-top: 6px;
    letter-spacing: var(--h-ls);
  }
  .rf-contact-note {
    font-size: 12px;
    color: var(--muted);
    margin-top: 4px;
  }

  @media (max-width: 980px) {
    .rf-contact {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
  @media (max-width: 640px) {
    .rf-form2 {
      grid-template-columns: 1fr;
    }
  }
</style>
