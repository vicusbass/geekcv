---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmtDate = (d: Date) => {
  const month = d.toLocaleString('en-US', { month: 'long' });
  return `${month} ${d.getFullYear()}`;
};
---

<div class="rf-page">
  <section class="rf-post-header">
    <a class="rf-post-back" href="/blog">← Writing</a>
    <h1 class="rf-post-title">{post.data.title}</h1>
    <div class="rf-post-meta">
      <span class="rf-post-date">{fmtDate(post.data.pubDate)}</span>
      {post.data.tags.length > 0 && (
        <div class="rf-post-tags">
          {post.data.tags.map((t) => <span class="rf-pill">{t}</span>)}
        </div>
      )}
    </div>
  </section>

  <article class="rf-post-prose">
    <Content />
  </article>

  <nav class="rf-post-footer">
    <a class="rf-textlink" href="/blog">← All writing</a>
    <a class="rf-textlink" href="/contact">Get in touch →</a>
  </nav>
</div>

<style>
  .rf-page {
    animation: vp-fade 0.5s ease both;
  }

  .rf-post-header {
    max-width: 720px;
    padding: 56px 0 32px;
    border-bottom: 1px solid var(--line);
  }
  .rf-post-back {
    font-size: 12px;
    letter-spacing: var(--kicker-ls);
    text-transform: var(--kicker-tt);
    color: var(--accent);
    font-weight: 700;
    text-decoration: none;
  }
  .rf-post-back:hover {
    opacity: 0.7;
  }
  .rf-post-title {
    font-family: var(--display);
    font-weight: var(--h-weight);
    font-size: clamp(30px, 4vw, 46px);
    color: var(--fg);
    margin: 18px 0 0;
    letter-spacing: var(--h-ls);
    line-height: 1.08;
  }
  .rf-post-meta {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 18px;
  }
  .rf-post-date {
    font-size: 13px;
    color: var(--muted);
    letter-spacing: 0.04em;
  }
  .rf-post-tags {
    display: flex;
    gap: 7px;
    flex-wrap: wrap;
  }

  /* article body */
  .rf-post-prose {
    max-width: 680px;
    padding-top: 36px;
    font-size: 17px;
    line-height: 1.75;
    color: #1a1a1d;
  }
  .rf-post-prose :global(p) {
    margin: 0 0 20px;
  }
  .rf-post-prose :global(h2) {
    font-family: var(--display);
    font-weight: 800;
    font-size: 26px;
    letter-spacing: var(--h-ls);
    color: var(--fg);
    margin: 38px 0 12px;
  }
  .rf-post-prose :global(h3) {
    font-family: var(--display);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: var(--h-ls);
    color: var(--fg);
    margin: 30px 0 10px;
  }
  .rf-post-prose :global(ul),
  .rf-post-prose :global(ol) {
    margin: 0 0 20px;
    padding-left: 24px;
  }
  .rf-post-prose :global(li) {
    margin: 6px 0;
  }
  .rf-post-prose :global(li::marker) {
    color: var(--accent);
  }
  .rf-post-prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .rf-post-prose :global(strong) {
    font-weight: 700;
    color: var(--fg);
  }
  .rf-post-prose :global(code) {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.86em;
    background: rgba(12, 12, 13, 0.05);
    border: 1px solid var(--line);
    padding: 1px 6px;
    border-radius: 3px;
  }
  .rf-post-prose :global(pre) {
    background: #0c0c0d;
    color: #f4f4f5;
    padding: 18px 20px;
    border-radius: 4px;
    overflow-x: auto;
    font-size: 13.5px;
    line-height: 1.6;
    margin: 0 0 22px;
  }
  .rf-post-prose :global(pre code) {
    background: transparent;
    border: 0;
    padding: 0;
    font-size: inherit;
    color: inherit;
  }
  .rf-post-prose :global(blockquote) {
    border-left: 3px solid var(--accent);
    margin: 24px 0;
    padding: 4px 0 4px 20px;
    color: var(--muted);
    font-style: italic;
  }
  .rf-post-prose :global(img) {
    max-width: 100%;
    height: auto;
    border: 1px solid var(--line);
  }
  .rf-post-prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--line);
    margin: 32px 0;
  }

  .rf-post-footer {
    max-width: 680px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }

  @media (max-width: 640px) {
    .rf-post-prose {
      font-size: 16px;
    }
  }
</style>
