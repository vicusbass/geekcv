---
import { type Lang, SERVICES_COPY, contactHref } from '../../lib/services';

interface Props {
  lang: Lang;
}

const copy = SERVICES_COPY[Astro.props.lang];
const { services, process, faq, ui } = copy;
const other = SERVICES_COPY[copy.lang === 'en' ? 'ro' : 'en'];
---

<div class="rf-page">
  <section class="rf-header-sec">
    <div class="rf-top">
      <div class="rf-kicker">{ui.kicker}</div>
      <a class="rf-lang" href={other.path} hreflang={other.lang} lang={other.lang}>{ui.switchLabel}</a>
    </div>
    <h1 class="rf-h1">{ui.h1}</h1>
    <p class="rf-intro">{ui.intro.join('')}</p>
    <nav class="rf-jump" aria-label={ui.kicker}>
      {services.map((s) => (
        <a class="rf-pill rf-jump-pill" href={`#${s.id}`}>{s.name}</a>
      ))}
    </nav>
  </section>

  <section class="rf-svc-grid">
    {services.map((s, i) => (
      <article class="rf-svc" id={s.id}>
        <div class="rf-svc-top">
          <span class="rf-svc-no">{(i + 1).toString().padStart(2, '0')}</span>
          {s.partner && (
            <a class="rf-svc-partner" href={s.partner.url} target="_blank" rel="noopener">
              {ui.partnerWith} {s.partner.name} ↗
            </a>
          )}
        </div>
        <h2 class="rf-svc-title">{s.heading}</h2>
        <p class="rf-svc-sum">{s.summary}</p>
        <ul class="rf-svc-inc">
          {s.includes.map((it) => <li>{it}</li>)}
        </ul>
        <div class="rf-svc-stack">
          {s.stack.map((t) => <span class="rf-pill">{t}</span>)}
        </div>
        <div class="rf-svc-foot">
          <a class="rf-textlink" href={contactHref(copy, s)}>{s.cta}</a>
        </div>
      </article>
    ))}
  </section>

  <section class="rf-sec">
    <div class="rf-kicker">{ui.processKicker}</div>
    <h2 class="rf-h2">{ui.processH2}</h2>
    <ol class="rf-proc">
      {process.map((p) => (
        <li class="rf-proc-step">
          <div class="rf-proc-no">{p.step}</div>
          <h3 class="rf-proc-title">{p.title}</h3>
          <p class="rf-proc-body">{p.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="rf-sec rf-faq-sec">
    <div>
      <div class="rf-kicker">{ui.faqKicker}</div>
      <h2 class="rf-h2">{ui.faqH2}</h2>
    </div>
    <div class="rf-faq">
      {faq.map((f) => (
        <details class="rf-faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="rf-cta">
    <div>
      <h2 class="rf-cta-h">{ui.ctaH2}</h2>
      <p class="rf-cta-p">{ui.ctaText}</p>
    </div>
    <div class="rf-cta-btns">
      <a class="rf-btn rf-btn-primary" href={contactHref(copy)}>{ui.ctaPrimary}</a>
      <a class="rf-btn rf-btn-ghost" href="/projects">{ui.ctaSecondary}</a>
    </div>
  </section>
</div>

<style>
  .rf-page {
    animation: vp-fade 0.5s ease both;
  }
  .rf-header-sec {
    padding: 64px 0 40px;
    border-bottom: 1px solid var(--line);
  }
  .rf-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }
  .rf-lang {
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    padding-bottom: 2px;
    transition: color 0.2s, border-color 0.2s;
  }
  .rf-lang:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .rf-h1 {
    font-family: var(--display);
    font-weight: var(--h-weight);
    font-size: clamp(34px, 4.6vw, 54px);
    color: var(--fg);
    margin: 16px 0 0;
    letter-spacing: var(--h-ls);
  }
  .rf-intro {
    color: var(--muted);
    font-size: 16px;
    line-height: 1.6;
    max-width: 60ch;
    margin: 16px 0 0;
  }
  .rf-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }
  .rf-jump-pill {
    text-decoration: none;
    font-size: 12.5px;
    padding: 6px 12px;
    transition: border-color 0.2s, color 0.2s;
  }
  .rf-jump-pill:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* services */
  .rf-svc-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    margin-top: 40px;
  }
  .rf-svc {
    background: var(--surface);
    padding: 30px 30px 26px;
    display: flex;
    flex-direction: column;
    scroll-margin-top: 24px;
  }
  .rf-svc:target {
    box-shadow: inset 3px 0 0 var(--accent);
  }
  .rf-svc-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  .rf-svc-no {
    font-family: var(--display);
    font-weight: 800;
    font-size: 13px;
    color: var(--accent);
    letter-spacing: 0.04em;
  }
  .rf-svc-partner {
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    text-decoration: none;
  }
  .rf-svc-partner:hover {
    color: var(--accent);
  }
  .rf-svc-title {
    font-family: var(--display);
    font-weight: 700;
    font-size: 24px;
    line-height: 1.15;
    color: var(--fg);
    margin: 14px 0 0;
    letter-spacing: var(--h-ls);
  }
  .rf-svc-sum {
    font-size: 14.5px;
    color: var(--muted);
    line-height: 1.6;
    margin: 10px 0 0;
  }
  .rf-svc-inc {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    font-size: 14px;
    color: var(--fg);
  }
  .rf-svc-inc li {
    position: relative;
    padding: 5px 0 5px 18px;
    border-top: 1px solid var(--line);
  }
  .rf-svc-inc li::before {
    content: '';
    position: absolute;
    left: 0;
    top: calc(5px + 0.8em - 3.5px);
    width: 7px;
    height: 7px;
    background: var(--accent);
  }
  .rf-svc-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 18px;
  }
  .rf-svc-foot {
    margin-top: auto;
    padding-top: 20px;
    font-size: 14px;
  }

  /* process */
  .rf-sec {
    padding: 72px 0 0;
  }
  .rf-h2 {
    font-family: var(--display);
    font-weight: var(--h-weight);
    font-size: clamp(28px, 3.2vw, 38px);
    color: var(--fg);
    margin: 10px 0 0;
    letter-spacing: var(--h-ls);
  }
  .rf-proc {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .rf-proc-step {
    background: var(--surface);
    padding: 26px 24px;
  }
  .rf-proc-no {
    font-family: var(--display);
    font-weight: 800;
    font-size: 13px;
    color: var(--accent);
  }
  .rf-proc-title {
    font-family: var(--display);
    font-weight: 700;
    font-size: 20px;
    color: var(--fg);
    margin: 12px 0 0;
    letter-spacing: var(--h-ls);
  }
  .rf-proc-body {
    font-size: 13.5px;
    color: var(--muted);
    line-height: 1.6;
    margin: 8px 0 0;
  }

  /* faq */
  .rf-faq-sec {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 48px;
    align-items: start;
  }
  .rf-faq {
    border-top: 1px solid var(--line);
  }
  .rf-faq-item {
    border-bottom: 1px solid var(--line);
  }
  .rf-faq-item summary {
    cursor: pointer;
    list-style: none;
    padding: 18px 32px 18px 0;
    position: relative;
    font-family: var(--display);
    font-weight: 700;
    font-size: 17px;
    color: var(--fg);
    letter-spacing: -0.01em;
  }
  .rf-faq-item summary::-webkit-details-marker {
    display: none;
  }
  .rf-faq-item summary::after {
    content: '+';
    position: absolute;
    right: 4px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-size: 22px;
    font-weight: 500;
  }
  .rf-faq-item[open] summary::after {
    content: '–';
  }
  .rf-faq-item p {
    margin: 0;
    padding: 0 0 20px;
    font-size: 14.5px;
    color: var(--muted);
    line-height: 1.6;
    max-width: 60ch;
  }

  /* cta */
  .rf-cta {
    margin-top: 80px;
    padding: 40px;
    background: var(--fg);
    color: var(--bg);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  .rf-cta-h {
    font-family: var(--display);
    font-weight: var(--h-weight);
    font-size: clamp(26px, 3vw, 34px);
    letter-spacing: var(--h-ls);
    margin: 0;
    color: var(--bg);
  }
  .rf-cta-p {
    margin: 8px 0 0;
    font-size: 15px;
    opacity: 0.7;
  }
  .rf-cta-btns {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .rf-cta .rf-btn-ghost {
    color: var(--bg);
    border-color: rgba(255, 255, 255, 0.3);
  }
  .rf-cta .rf-btn-ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  @media (max-width: 980px) {
    .rf-proc {
      grid-template-columns: repeat(2, 1fr);
    }
    .rf-faq-sec {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
  @media (max-width: 760px) {
    .rf-svc-grid {
      grid-template-columns: 1fr;
    }
    .rf-svc {
      padding: 24px 20px 22px;
    }
    .rf-cta {
      padding: 28px 22px;
    }
  }
  @media (max-width: 480px) {
    .rf-proc {
      grid-template-columns: 1fr;
    }
  }
</style>
