---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import { getAsset } from '../../lib/assets';
import { HOME, CONTACT } from '../../lib/home';

const featured = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const thumbs = await Promise.all(
  featured.map(async (p) => {
    const src = getAsset(p.data.shot);
    if (!src) return null;
    const img = await getImage({ src, widths: [480, 720], format: 'webp', quality: 82 });
    return { src: img.src, srcset: img.srcSet.attribute };
  }),
);

const portraitSrc = getAsset('profile.png');
const portrait = portraitSrc
  ? await getImage({ src: portraitSrc, width: 720, format: 'webp', quality: 85 })
  : null;

const headline = HOME.headline.map((l) => `${l.pre}${l.em}${l.post}`).join(' ');
const { cta } = HOME;
---

<div class="rf-page">
  <!-- hero -->
  <section class="rf-hero">
    <div>
      <div class="rf-kicker">{HOME.positioning}</div>
      <h1 class="rf-hero-h1">{headline}</h1>
      <p class="rf-hero-lead">{HOME.lead}</p>
      <p class="rf-hero-avail">{HOME.availability} {HOME.offClock}</p>
      <div class="rf-hero-cta">
        <a class="rf-btn rf-btn-primary" href="/contact">{cta.primary}</a>
        <a class="rf-btn rf-btn-ghost" href="/projects">{cta.secondary}</a>
      </div>
      <dl class="rf-hero-stats">
        {HOME.stats.map((s) => (
          <div>
            <dt class="rf-stat-n">{s.n}</dt>
            <dd class="rf-stat-l">{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>
    <div class="rf-portrait-wrap">
      <div class="rf-portrait">
        {portrait && (
          <img src={portrait.src} alt={HOME.name} loading="eager" />
        )}
        <div class="rf-portrait-bar">
          <div>
            <div class="rf-portrait-name">{HOME.name}</div>
            <div class="rf-portrait-loc">{HOME.location}</div>
          </div>
          <div class="rf-portrait-tag">SDET</div>
        </div>
      </div>
    </div>
  </section>

  <!-- clients strip -->
  <section class="rf-clients" aria-label="Worked with">
    <div class="rf-clients-row">
      <span class="rf-clients-label">Worked with</span>
      {HOME.clients.map((c) => <span class="rf-client">{c}</span>)}
    </div>
  </section>

  <!-- selected work -->
  <section class="rf-work">
    <div class="rf-work-head">
      <h2 class="rf-h2">{cta.workTitle}</h2>
      <a class="rf-textlink" href="/projects">{cta.allWork}</a>
    </div>
    <div class="rf-grid2">
      {featured.map((p, i) => (
        <a class="rf-workcard" href={p.data.url} target="_blank" rel="noreferrer">
          <div class="rf-workcard-shot">
            {thumbs[i] && (
              <img src={thumbs[i]!.src} srcset={thumbs[i]!.srcset} sizes="(max-width:760px) 92vw, 520px" alt="" loading="lazy" />
            )}
          </div>
          <div class="rf-workcard-body">
            <div class="rf-workcard-meta">
              <span class="rf-workcard-kind">{p.data.kind}</span>
              <span class="rf-workcard-year">{p.data.year}</span>
            </div>
            <div class="rf-workcard-title">
              {p.data.title}
              <span class="rf-workcard-ext" aria-hidden="true">↗</span>
              <span class="sr-only">{cta.externalNote}</span>
            </div>
            <div class="rf-workcard-blurb">{p.data.blurb}</div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- capabilities -->
  <section class="rf-caps">
    <div class="rf-work-head">
      <h2 class="rf-h2">{cta.capsTitle}</h2>
      <a class="rf-textlink" href="/services">{cta.allServices}</a>
    </div>
    <ul class="rf-grid3 rf-caps-grid">
      {HOME.capabilities.map((cap) => (
        <li class="rf-cap">
          <h3 class="rf-cap-title">{cap.title}</h3>
          <p class="rf-cap-body">{cap.body}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- close -->
  <section class="rf-close" aria-labelledby="rf-close-h">
    <div class="rf-close-top">
      <div>
        <h2 class="rf-close-h" id="rf-close-h">{cta.closeTitle}</h2>
        <p class="rf-close-p">{cta.closeText}</p>
      </div>
      <div class="rf-close-act">
        <a class="rf-btn rf-btn-primary" href="/contact">{cta.primary}</a>
        <span class="rf-close-mail">
          {cta.emailLabel} <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
        </span>
      </div>
    </div>
    <ol class="rf-close-steps">
      {HOME.process.map((p) => (
        <li>
          <span class="rf-close-no">{p.step}</span>
          <h3 class="rf-close-title">{p.title}</h3>
          <p class="rf-close-body">{p.body}</p>
        </li>
      ))}
    </ol>
    <a class="rf-close-ro" href="/ro/servicii" hreflang="ro" lang="ro">{cta.roLink}</a>
  </section>
</div>

<style>
  .rf-page {
    animation: vp-fade 0.5s ease both;
  }

  /* hero */
  .rf-hero {
    display: grid;
    grid-template-columns: 1.35fr 0.9fr;
    gap: 56px;
    align-items: center;
    padding: 72px 0 64px;
  }
  .rf-hero-h1 {
    font-family: var(--display);
    font-weight: var(--h-weight);
    letter-spacing: var(--h-ls);
    line-height: 1.02;
    font-size: clamp(40px, 5.6vw, 64px);
    color: var(--fg);
    margin: 22px 0 0;
    text-wrap: balance;
  }
  .rf-hero-lead {
    color: var(--muted);
    font-size: 17px;
    line-height: 1.65;
    max-width: 56ch;
    margin: 26px 0 0;
  }
  .rf-hero-avail {
    color: var(--fg);
    font-size: 15px;
    line-height: 1.6;
    max-width: 56ch;
    margin: 14px 0 0;
  }
  .rf-hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .rf-hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    margin: 40px 0 0;
    padding-top: 26px;
    border-top: 1px solid var(--line);
  }
  .rf-hero-stats dd {
    margin: 0;
  }
  .rf-stat-n {
    font-family: var(--display);
    font-weight: 800;
    font-size: 30px;
    color: var(--fg);
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .rf-stat-l {
    font-size: 12.5px;
    color: var(--muted);
    margin-top: 5px;
    letter-spacing: 0.03em;
  }

  /* portrait */
  .rf-portrait-wrap {
    position: relative;
  }
  .rf-portrait {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .rf-portrait img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
  }
  .rf-portrait-bar {
    padding: 16px 18px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--line);
  }
  .rf-portrait-name {
    font-family: var(--display);
    font-weight: 800;
    font-size: 15px;
    color: var(--fg);
    letter-spacing: -0.02em;
  }
  .rf-portrait-loc {
    font-size: 12.5px;
    color: var(--muted);
    margin-top: 2px;
  }
  .rf-portrait-tag {
    font-size: 12px;
    color: var(--accent-text);
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  /* clients */
  .rf-clients {
    padding: 6px 0 8px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .rf-clients-row {
    display: flex;
    align-items: center;
    gap: 10px 22px;
    flex-wrap: wrap;
    padding: 18px 0;
  }
  .rf-clients-label {
    font-size: 12px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    margin-right: 6px;
  }
  .rf-client {
    font-family: var(--display);
    font-weight: 700;
    font-size: 17px;
    color: var(--fg);
    opacity: 0.7;
    letter-spacing: -0.02em;
  }

  /* selected work */
  .rf-work {
    padding: 64px 0 0;
  }
  .rf-work-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 28px;
  }
  .rf-work-head .rf-textlink {
    white-space: nowrap;
  }
  .rf-h2 {
    font-family: var(--display);
    font-weight: var(--h-weight);
    font-size: clamp(28px, 3.2vw, 38px);
    color: var(--fg);
    margin: 0;
    letter-spacing: var(--h-ls);
    text-wrap: balance;
  }
  .rf-grid2 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .rf-workcard {
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
    display: flex;
    flex-direction: column;
    transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.22s ease;
  }
  .rf-workcard:hover,
  .rf-workcard:focus-visible {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }
  .rf-workcard-shot {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .rf-workcard-shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .rf-workcard-body {
    padding: 18px 20px 20px;
  }
  .rf-workcard-meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
  }
  .rf-workcard-kind {
    font-size: 12px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .rf-workcard-year {
    font-size: 12px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .rf-workcard-title {
    font-family: var(--display);
    font-weight: 700;
    font-size: 22px;
    color: var(--fg);
    margin-top: 8px;
    letter-spacing: var(--h-ls);
  }
  .rf-workcard-ext {
    font-size: 15px;
    color: var(--muted);
    margin-left: 4px;
    transition: color 0.2s;
  }
  .rf-workcard:hover .rf-workcard-ext {
    color: var(--accent-text);
  }
  .rf-workcard-blurb {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.55;
    margin-top: 7px;
  }

  /* capabilities */
  .rf-caps {
    padding: 72px 0 0;
  }
  .rf-grid3 {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .rf-cap {
    background: var(--surface);
    padding: 28px 26px;
  }
  .rf-cap-title {
    font-family: var(--display);
    font-weight: 700;
    font-size: 21px;
    color: var(--fg);
    margin: 0;
    letter-spacing: var(--h-ls);
  }
  .rf-cap-body {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.6;
    margin: 10px 0 0;
  }

  /* close: same ink block as the services CTA */
  .rf-close {
    margin-top: 88px;
    padding: 44px 40px 36px;
    background: var(--fg);
    color: var(--bg);
  }
  .rf-close-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px 40px;
    flex-wrap: wrap;
  }
  .rf-close-h {
    font-family: var(--display);
    font-weight: var(--h-weight);
    font-size: clamp(28px, 3.2vw, 38px);
    letter-spacing: var(--h-ls);
    line-height: 1.08;
    margin: 0;
    color: var(--bg);
    text-wrap: balance;
  }
  .rf-close-p {
    margin: 10px 0 0;
    font-size: 16px;
    color: rgba(255, 255, 255, 0.72);
  }
  .rf-close-act {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
  .rf-close-mail {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.72);
  }
  .rf-close-mail a {
    color: var(--bg);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
  .rf-close-mail a:hover {
    color: var(--accent);
  }
  .rf-close-steps {
    list-style: none;
    margin: 40px 0 0;
    padding: 28px 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }
  .rf-close-no {
    font-family: var(--display);
    font-weight: 800;
    font-size: 13px;
    color: var(--accent);
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }
  .rf-close-title {
    font-family: var(--display);
    font-weight: 700;
    font-size: 19px;
    letter-spacing: var(--h-ls);
    margin: 8px 0 0;
    color: var(--bg);
  }
  .rf-close-body {
    font-size: 14px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.72);
    margin: 6px 0 0;
  }
  .rf-close-ro {
    display: inline-block;
    margin-top: 32px;
    font-size: 14px;
    font-weight: 600;
    color: var(--bg);
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.35);
    text-underline-offset: 4px;
  }
  .rf-close-ro:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }
  .rf-close :focus-visible {
    outline-color: var(--bg);
  }

  @media (max-width: 980px) {
    .rf-hero {
      grid-template-columns: 1fr;
      gap: 38px;
      padding-top: 48px;
    }
    .rf-portrait-wrap {
      max-width: 380px;
    }
    .rf-close-steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 760px) {
    .rf-grid2,
    .rf-grid3 {
      grid-template-columns: 1fr;
    }
    .rf-close {
      padding: 32px 22px 28px;
    }
  }
  @media (max-width: 480px) {
    .rf-close-steps {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .rf-work-head {
      flex-wrap: wrap;
    }
  }
</style>
