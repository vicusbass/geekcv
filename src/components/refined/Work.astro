---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import { getAsset } from '../../lib/assets';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);

const shots = await Promise.all(
  projects.map(async (p) => {
    const src = getAsset(p.data.shot);
    if (!src) return null;
    const img = await getImage({ src, widths: [480, 720, 960], format: 'webp', quality: 82 });
    return { src: img.src, srcset: img.srcSet.attribute };
  }),
);
---

<div class="rf-page">
  <section class="rf-header-sec">
    <div class="rf-kicker">Selected work</div>
    <h1 class="rf-h1">Projects &amp; products</h1>
    <p class="rf-intro">
      A mix of client web builds in Astro and Next.js, plus open-source test
      tooling. Everything here is live or shipped.
    </p>
  </section>

  <section class="rf-grid2 rf-work-grid">
    {projects.map((p, i) => (
      <div class="rf-card">
        <div class="rf-card-shot">
          {shots[i] ? (
            <img src={shots[i]!.src} srcset={shots[i]!.srcset} sizes="(max-width:760px) 92vw, 520px" alt={p.data.title} loading="lazy" />
          ) : (
            <span class="rf-card-mark">{p.data.title.charAt(0)}</span>
          )}
        </div>
        <div class="rf-card-body">
          <div class="rf-card-meta">
            <span class="rf-card-kind">{p.data.kind}</span>
            <span class="rf-card-year">{p.data.year}</span>
          </div>
          <div class="rf-card-title">{p.data.title}</div>
          <div class="rf-card-blurb">{p.data.blurb}</div>
          <div class="rf-card-stack">
            {p.data.stack.map((s) => <span class="rf-pill">{s}</span>)}
          </div>
          <div class="rf-card-foot">
            <span class="rf-card-role">{p.data.role}</span>
            <a class="rf-card-visit" href={p.data.url} target="_blank" rel="noreferrer">Visit ↗</a>
          </div>
        </div>
      </div>
    ))}
  </section>
</div>

<style>
  .rf-page {
    animation: vp-fade 0.5s ease both;
  }
  .rf-header-sec {
    padding: 64px 0 40px;
    border-bottom: 1px solid var(--line);
  }
  .rf-h1 {
    font-family: var(--display);
    font-weight: var(--h-weight);
    font-size: clamp(34px, 4.6vw, 54px);
    color: var(--fg);
    margin: 16px 0 0;
    letter-spacing: var(--h-ls);
  }
  .rf-intro {
    color: var(--muted);
    font-size: 16px;
    line-height: 1.6;
    max-width: 58ch;
    margin: 16px 0 0;
  }

  .rf-grid2 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px;
  }
  .rf-work-grid {
    padding-top: 36px;
  }
  .rf-card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.22s ease;
  }
  .rf-card:hover {
    box-shadow: var(--shadow);
  }
  .rf-card-shot {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .rf-card-shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .rf-card-mark {
    font-family: var(--display);
    font-weight: 800;
    font-size: 64px;
    color: var(--accent);
    opacity: 0.5;
    letter-spacing: -0.04em;
  }
  .rf-card-body {
    padding: 20px 22px 22px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .rf-card-meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
  }
  .rf-card-kind {
    font-size: 11px;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
  }
  .rf-card-year {
    font-size: 11.5px;
    color: var(--muted);
  }
  .rf-card-title {
    font-family: var(--display);
    font-weight: 700;
    font-size: 24px;
    color: var(--fg);
    margin-top: 8px;
    letter-spacing: var(--h-ls);
  }
  .rf-card-blurb {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.58;
    margin-top: 8px;
  }
  .rf-card-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 16px;
  }
  .rf-card-foot {
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .rf-card-role {
    font-size: 12px;
    color: var(--muted);
  }
  .rf-card-visit {
    font-size: 13px;
    color: var(--accent);
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 760px) {
    .rf-grid2 {
      grid-template-columns: 1fr;
    }
  }
</style>
