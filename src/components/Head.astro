---
/**
 * Shared SEO `<head>` fragment used by every layout/document (Terminal, Refined,
 * and the Gate) so meta, Open Graph, Twitter and JSON-LD stay identical across
 * presentations. Theme-specific bits — `theme-color` and font `<link>`s — stay
 * in each layout, since they differ between the geek and refined looks.
 */
interface Props {
  title: string;
  description?: string;
  /** Pass `null` to opt out of the default social card. */
  ogImage?: string | null;
  /** Pixel dimensions of `ogImage`. Defaults match `/og-default.png` (1200×630). */
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  canonical?: string;
  publishedTime?: string;
  tags?: string[];
}

const {
  title,
  description = 'Vasile Pop — SDET & web development consultant. 21+ years of test automation, Playwright, pytest, k6 and shipping web apps in TypeScript and Python. Cluj-Napoca, remote.',
  ogImage = '/og-default.png',
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogType = 'website',
  noindex = false,
  jsonLd,
  canonical: canonicalProp,
  publishedTime,
  tags,
} = Astro.props;

const SITE = Astro.site?.toString().replace(/\/$/, '') ?? 'https://www.vicusbass.com';
const canonical = canonicalProp ?? new URL(Astro.url.pathname, SITE).toString();
const ogImageAbs = ogImage
  ? ogImage.startsWith('http')
    ? ogImage
    : `${SITE}${ogImage}`
  : null;
// WhatsApp & some Slack builds skip the image when og:image:type is missing.
const ogImageMime = (() => {
  if (!ogImageAbs) return null;
  const ext = ogImageAbs.split('?')[0].split('.').pop()?.toLowerCase();
  if (ext === 'jpg' || ext === 'jpeg') return 'image/jpeg';
  if (ext === 'webp') return 'image/webp';
  if (ext === 'gif') return 'image/gif';
  return 'image/png';
})();
const fullTitle = title.includes('Vasile Pop') || title.includes('vicusbass')
  ? title
  : `${title} · vicusbass`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta name="author" content="Vasile Pop" />

<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
{ogImageAbs && (
  <>
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:secure_url" content={ogImageAbs} />
    <meta property="og:image:type" content={ogImageMime} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={description} />
  </>
)}
<meta property="og:site_name" content="vicusbass" />
<meta property="og:locale" content="en_US" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{tags?.map((t) => <meta property="article:tag" content={t} />)}

<meta name="twitter:card" content={ogImageAbs ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{ogImageAbs && <meta name="twitter:image" content={ogImageAbs} />}

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

{jsonLd && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
)}
